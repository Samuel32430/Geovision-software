# ==========================================
# GeoVision - Root GitIgnore
# ==========================================

# -----------------
# Node / Frontend
# -----------------
**/node_modules/
**/dist/
**/.angular/
**/.angular/cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -----------------
# Java / Backend (Maven)
# -----------------
**/target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
*.class

# -----------------
# IDEs and Editors
# -----------------
.idea/
.vscode/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
.DS_Store
Thumbs.db

# -----------------
# Environment & Secrets
# -----------------
.env
.env.local
.env.*.local
*.log

# -----------------
# Docker / Database local mounts
# -----------------
**/oradata/
